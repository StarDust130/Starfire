# Starfire V1.0 (Eve foundation)
#
# Copy to .env (root) and/or apps/desktop/.env and fill in what you use.
# Never commit real keys.

# ── Eve agent (agent/) ────────────────────────────────────────────────
# agent/agent.ts routes through the Vercel AI Gateway. Authenticate with:
#   pnpm exec eve link        (pull AI Gateway credentials)
# or use a direct provider key instead:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Realtime voice (apps/desktop) ─────────────────────────────────────
EMPIRIOLABS_API_KEY=
# optional — only if you want to override the URL derived from realtimeVoice.ts:
EMPIRIOLABS_REALTIME_URL=

# ── Starfire device bridge (Eve agent → Electron) ─────────────────────
# URL the Eve tools use to reach the Electron device bridge.
STARFIRE_DEVICE_URL=http://127.0.0.1:17321
# optional shared secret; when set, both sides must match.
STARFIRE_DEVICE_TOKEN=

# ── Memory V1.1 (Electron main process) ───────────────────────────────
# GLM key for long-term memory extraction. Without it, conversations
# are still captured locally; cloud extraction simply stays idle and
# jobs fail permanently after one attempt (no retry spam).
STARFIRE_MEMORY_API_KEY=
# Optional switches (defaults are sensible — uncomment to change):
# STARFIRE_MEMORY_CLOUD_DISABLED=1     # kill switch for cloud extraction
# STARFIRE_MEMORY_DISABLED=1           # disable all memory (no database)
# STARFIRE_MEMORY_DB_PATH=             # custom database file location
# STARFIRE_MEMORY_MODEL=glm-4-7-flash  # extraction model
# STARFIRE_MEMORY_BASE_URL=https://api.empiriolabs.ai/v1
# STARFIRE_GLM_MAX_RPM=20              # provider requests/minute ceiling
# STARFIRE_GLM_MIN_INTERVAL_MS=3000    # minimum gap between requests

# ── Web search (Electron main process) ────────────────────────────────
EXA_API_KEY=

# ── Evals ─────────────────────────────────────────────────────────────
STARFIRE_EVAL_TIMEOUT_MS=
STARFIRE_EVAL_TRIALS=