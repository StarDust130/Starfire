# =========================================================
# 🌟 STARFIRE - .gitignore
# =========================================================

# -------------------------
# 📦 Node / JavaScript
# -------------------------
node_modules/
.pnpm-store/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Package manager lockfiles
# Keep pnpm-lock.yaml tracked
package-lock.json
yarn.lock

# -------------------------
# 🏗️ Build output
# -------------------------
dist/
build/
out/
.tmp/
temp/
.cache/
.turbo/
.vite/
*.tsbuildinfo

# Next.js (if used later)
.next/
.vercel/

# -------------------------
# -------------------------
target/
**/target/

src-tauri/target/
src-tauri/gen/
src-tauri/.cargo/

# Rust temporary / backup files
**/*.rs.bk

# -------------------------
# 🔐 Environment / Secrets
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# 🤖 Local AI Models
# -------------------------
# Never commit large local model files
*.gguf
*.ggml
*.bin
*.safetensors
*.onnx

# Local model/cache directories
models/
model/
ai-models/
.cache/
huggingface/
hf-cache/

# -------------------------
# 📝 Logs
# -------------------------
*.log
logs/

# -------------------------
# 🧪 Testing / Coverage
# -------------------------
coverage/
.nyc_output/
.pytest_cache/

# -------------------------
# 🖥️ OS files
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# 🧑‍💻 Editors / IDE
# -------------------------
.idea/
*.iml

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# -------------------------
# 🔧 Local tooling
# -------------------------
*.swp
*.swo
*~
*.tmp

# -------------------------
# 🏠 Local Starfire data
# -------------------------
data/
local/
runtime/
storage/

# SQLite databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3