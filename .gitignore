# =========================================================
# 🌟 STARFIRE — .gitignore
# =========================================================

# =========================================================
# 📦 Node / JavaScript / TypeScript
# =========================================================
node_modules/
.pnpm-store/
.npm/
.npmrc.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Keep pnpm-lock.yaml tracked
package-lock.json
yarn.lock

# TypeScript
*.tsbuildinfo

# =========================================================
# 🏗️ Build / Generated Output
# =========================================================
dist/
build/
out/
target/
**/target/

.tmp/
tmp/
temp/
**/.tmp/
**/tmp/
**/temp/

.cache/
**/.cache/

.vite/
**/.vite/

.turbo/
**/.turbo/

.parcel-cache/
.eslintcache

# Electron
apps/desktop/electron-dist/
electron-dist/

# =========================================================
# ⚛️ Frontend Frameworks
# =========================================================

# Next.js (future)
.next/
.vercel/

# Remix
.build/

# =========================================================
# 🦀 Rust / Tauri
# =========================================================

# Rust build output
target/
**/target/

# Tauri generated files
src-tauri/gen/
src-tauri/target/
src-tauri/.cargo/

**/src-tauri/target/
**/src-tauri/gen/
**/src-tauri/.cargo/

# Rust backup files
*.rs.bk

# =========================================================
# 🔐 Environment / Secrets
# =========================================================

.env
.env.*
!.env.example
!.env.example.*
!.env.template
!.env.sample

# Local secret / credential files
*.pem
*.key
*.crt
*.p12
*.pfx

# =========================================================
# 🤖 Local AI / ML Models
# =========================================================

# Model files
*.gguf
*.ggml
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt
*.bin

# Large datasets / embeddings
*.npz
*.npy

# Local model directories
models/
model/
ai-models/
local-models/

**/models/
**/model/
**/ai-models/
**/local-models/

# Hugging Face / ML caches
huggingface/
hf-cache/
huggingface-cache/

**/huggingface/
**/hf-cache/
**/huggingface-cache/

# =========================================================
# 🐍 Python / DeepEval
# =========================================================

# Virtual environments
.venv/
venv/
env/
**/.venv/
**/venv/
**/env/

# Python cache
__pycache__/
**/__pycache__/

*.py[cod]
*$py.class

# Python tooling
.pytest_cache/
**/.pytest_cache/

.mypy_cache/
**/.mypy_cache/

.ruff_cache/
**/.ruff_cache/

.coverage
.coverage.*
htmlcov/

# =========================================================
# 🧪 Testing / Coverage
# =========================================================

coverage/
**/coverage/

.nyc_output/
**/.nyc_output/

test-results/
**/test-results/

playwright-report/
**/playwright-report/

playwright/.cache/

# =========================================================
# 📊 Eval Generated Reports
# =========================================================

# Generated evaluation output should not be committed.
eval/reports/*
!eval/reports/.gitkeep

# Generated eval artifacts
eval/output/
eval/results/
eval/artifacts/

# =========================================================
# 📝 Logs / Runtime
# =========================================================

*.log
logs/
**/logs/

*.pid
*.pid.lock

runtime/
**/runtime/

# =========================================================
# 🗃️ Local Data / Databases
# =========================================================

data/
**/data/

local/
**/local/

storage/
**/storage/

# SQLite
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# =========================================================
# 🖥️ OS Files
# =========================================================

.DS_Store
**/.DS_Store

Thumbs.db
desktop.ini

# =========================================================
# 🧑‍💻 IDE / Editors
# =========================================================

.idea/
*.iml

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*.swn
*~

# Emacs
*#

# =========================================================
# 🔧 Local Tooling / Temporary Files
# =========================================================

*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej

.DS_Store
Thumbs.db

# =========================================================
# 📦 OS / Package Manager Artifacts
# =========================================================

.npm/
.yarn/
.pnpm-debug.log

# =========================================================
# 🔒 Local Certificates / Keys
# =========================================================

*.pem
*.key
*.secret
*.secret.*
secrets/
**/secrets/

# =========================================================
# 📁 Optional Local Starfire State
# =========================================================

.starfire/
.starfire-local/
**/.starfire/
**/.starfire-local/

# =========================================================
# ✅ Keep Empty Directories
# =========================================================

!.gitkeep
!**/.gitkeep
.eve